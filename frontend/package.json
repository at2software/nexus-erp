{
  "name": "NEXUS",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run generate:models && ng serve",
    "build": "npm run generate:models && ng build",
    "build:i18n": "npm run generate:models && ng build --localize --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "extract-and-translate": "ng extract-i18n && python translate.py",
    "generate:models": "node scripts/generate-model-registry.js",
    "lint": "ng lint",
    "analyze": "ng build --configuration=production --stats-json && esbuild-visualizer --metadata dist/nexus/stats.json --filename dist/nexus/stats.html"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.5",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/localize": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "class-transformer": "^0.5.1",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "keycloak-angular": "^21.0.0",
    "keycloak-js": "^26.2.1",
    "laravel-echo": "^2.2.7",
    "leaflet": "^1.9.4",
    "material-icons": "^1.13.1",
    "ngx-color-picker": "^20.1.1",
    "ngx-daterangepicker-material": "^6.0.4",
    "ngx-echarts": "^21.0.0",
    "ngx-quill": "^30.1.3",
    "ngx-scrollbar": "^18.0.0",
    "node-forge": "^1.4.0",
    "pusher-js": "^8.4.0",
    "quill": "2.0.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^21.0.4",
    "@angular/build": "^21.2.15",
    "@angular/cli": "^21.2.15",
    "@angular/compiler-cli": "^21.2.17",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20.19.21",
    "@types/node-forge": "^1.3.14",
    "@types/tinycolor2": "^1.4.3",
    "angular-eslint": "21.3.1",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^16.1.2",
    "tinycolor2": "^1.6.0",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "overrides": {
    "quill": "2.0.2",
    "@babel/core": "7.29.7",
    "esbuild": "0.28.1",
    "http-proxy-middleware": "3.0.7",
    "piscina": "5.2.0",
